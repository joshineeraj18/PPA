<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/card_view"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:layout_marginHorizontal="20dp"
        app:cardBackgroundColor="@color/teal_200"
        app:cardCornerRadius="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="5dp">

            <TextView
                android:id="@+id/web_name_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:gravity="center"
                android:text="WebName"
                android:textSize="28dp"
                android:textStyle="bold" />

            <androidx.cardview.widget.CardView
                android:id="@+id/card_view_uname"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:padding="10dp"
                app:cardBackgroundColor="@color/teal_700"
                app:cardCornerRadius="5dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="8dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0"
                            android:maxLines="1"
                            android:text="Username:"
                            android:textColor="@color/text_incard_color"
                            android:textSize="26dp"
                            android:visibility="invisible" />

                        <TextView
                            android:id="@+id/username_tv"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:gravity="center"
                            android:maxLines="1"
                            android:scrollbars="horizontal"
                            android:text="bhairaviwellbeing@website"
                            android:textColor="@color/text_incard_color"
                            android:textSize="20dp" />


                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/card_view_pass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:padding="10dp"
                app:cardBackgroundColor="@color/teal_700"
                app:cardCornerRadius="5dp"
                app:cardElevation="0dp">



            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_margin="8dp"
                android:weightSum="2">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0"
                    android:text="Password:"
                    android:visibility="gone"
                    android:textColor="@color/text_incard_color"
                    android:textSize="26dp" />

                <TextView
                    android:id="@+id/pass_tv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_weight="2"
                    android:text="************"
                    android:textColor="@color/text_incard_color"
                    android:textSize="20dp" />

            </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>


    </androidx.cardview.widget.CardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/card_view"
        android:layout_alignLeft="@+id/card_view"
        android:layout_marginTop="46dp"
        android:layout_marginLeft="25dp"
        android:paddingHorizontal="10dp"
        android:textSize="16sp"
        android:textColor="#DAD9D5"
        android:elevation="10dp"
        android:background="@drawable/uname_back"
        android:text="Username" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/card_view"
        android:layout_alignLeft="@+id/card_view"
        android:layout_marginTop="116dp"
        android:layout_marginLeft="25dp"
        android:paddingHorizontal="10dp"
        android:textSize="16sp"
        android:textColor="#DAD9D5"
        android:elevation="10dp"
        android:background="@drawable/uname_back"
        android:text="Password" />

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20sp"
        android:layout_alignParentRight="true">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab"
            android:layout_width="56dp"
            android:layout_height="56dp"
            app:fabSize="normal"
            app:elevation="6dp"
            android:backgroundTint="#F1291A"
            android:scaleType="center"
            app:tint="@android:color/white" />

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:elevation="16dp"

            android:layout_gravity="center"
            android:src="@drawable/ic_baseline_delete_outline_24" />
    </FrameLayout>


</RelativeLayout>